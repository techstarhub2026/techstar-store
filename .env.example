# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="TechStar Store"
APP_URL=http://localhost:5273
SITE_URL=http://localhost:8000
API_PORT=4100
LOG_LEVEL=info

# ── Database (XAMPP MySQL/MariaDB) ────────────────────────────────────
DATABASE_URL="mysql://root@127.0.0.1:3306/techstar"

# ── Security ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-32-random-bytes-base64-encoded-value
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_DRIVER=local
MEDIA_ROOT=./uploads
MEDIA_PUBLIC_URL=http://localhost:4100/media

# ── Email (dev: leave blank to log to console) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="TechStar Store"
MAIL_FROM_ADDRESS=orders@techstar.co.tz

# ── SMS (dev: console) ────────────────────────────────────────────────
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=TECHSTAR

# ── Business rules ────────────────────────────────────────────────────
RESERVATION_HOURS=48

# ── Seed ──────────────────────────────────────────────────────────────
SEED_OWNER_EMAIL=admin@techstar.co.tz
SEED_OWNER_PASSWORD="TechStar#2026"
SEED_DEMO=true

# ── Front end ─────────────────────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_WHATSAPP_NUMBER=255700000000
